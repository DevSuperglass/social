<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="whatsapp_request_response_null_action" model="ir.actions.act_window">
        <field name="name">Requisições sem resposta do Whatsapp</field>
        <field name="res_model">whatsapp.request</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('response', '=', False)]</field>
    </record>

    <menuitem
        id="whatsapp_request_response_null_menuitem"
        name="Requisições do WhatsApp"
        action="whatsapp_request_response_null_action"
        parent="mail.mail_menu_technical"
        sequence="3"
    />

    <record id="whatsapp_request_response_null_view" model="ir.ui.view">
        <field name="name">whatsapp.request.response.null.view</field>
        <field name="model">whatsapp.request</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree create="0">
                <header>
                    <button name="action_button_reset_response" type="object" string="Resetar Resposta"/>
                </header>
                <field name="mail_message_id"/>
                <field name="write_uid" string="Usuário"/>
                <field name="write_date" string="Data de envio"/>
            </tree>
        </field>
    </record>
</odoo>
