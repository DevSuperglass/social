<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     data-string="WhatsApp"
                     string="WhatsApp"
                     data-key="mail_gateway_whatsapp"
                     groups="base.group_system">
                    <h2>WhatsApp</h2>
                    <div class="row mt16 o_settings_container">

                        <!-- Seleção do provedor ativo -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mail_gateway_whatsapp_transcription_provider" string="Provedor de Transcrição"/>
                                <div class="text-muted">
                                    Selecione qual serviço será utilizado para transcrever áudios recebidos via WhatsApp.
                                </div>
                                <div class="mt8">
                                    <field name="mail_gateway_whatsapp_transcription_provider"/>
                                </div>
                            </div>
                        </div>

                        <!-- Groq -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mail_gateway_whatsapp_groq_api_key" string="API Key — Groq (whisper-large-v3)"/>
                                <div class="text-muted">
                                    Chave da API Groq para transcrição via Whisper Large V3.
                                </div>
                                <div class="mt8">
                                    <field name="mail_gateway_whatsapp_groq_api_key" password="True"/>
                                </div>
                            </div>
                        </div>

                        <!-- Deepgram -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mail_gateway_whatsapp_deepgram_api_key" string="API Key — Deepgram (nova-2, pt-BR)"/>
                                <div class="text-muted">
                                    Chave da API Deepgram para transcrição com modelo Nova-2 em português.
                                </div>
                                <div class="mt8">
                                    <field name="mail_gateway_whatsapp_deepgram_api_key" password="True"/>
                                </div>
                            </div>
                        </div>

                        <!-- AssemblyAI -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mail_gateway_whatsapp_assemblyai_api_key" string="API Key — AssemblyAI (Universal, pt)"/>
                                <div class="text-muted">
                                    Chave da API AssemblyAI para transcrição com modelo Universal em português.
                                </div>
                                <div class="mt8">
                                    <field name="mail_gateway_whatsapp_assemblyai_api_key" password="True"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
