<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ThreadViewTopbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_ThreadViewTopbar_debugInfo')]" position="inside">
            <span class="o_ThreadViewTopbar_debugBadge rounded-pill border px-2 py-0 me-1 small text-600" title="Tipo de atendimento (attendance_type)">
                Atendimento: <t t-esc="threadViewTopbar.thread.attendance_type || 'vazio'"/>
            </span>
        </xpath>
    </t>
</templates>
