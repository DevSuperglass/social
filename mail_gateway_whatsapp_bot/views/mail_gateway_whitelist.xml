<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_gateway_whitelist_form_bot_inherit" model="ir.ui.view">
        <field name="name">mail.gateway.whitelist.form.bot.inherit</field>
        <field name="model">mail.gateway.whitelist</field>
        <field name="inherit_id" ref="mail_gateway_whatsapp.mail_gateway_whitelist_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='code_page']" position="before">
                <page name="bot_contacts_page" string="Clientes do Bot" attrs="{'invisible': [('name', '!=', 'ChatBot')]}">
                    <field name="contact_line_ids">
                        <tree editable="bottom">
                            <field name="allowed_parent_ids" invisible="1"/>
                            <field name="parent_id" string="Contato Principal"
                                   domain="[('id', 'in', allowed_parent_ids)]"/>
                            <field name="children_ids" string="Contatos Filhos" widget="many2many_tags" readonly="1"
                                   options="{'color_field': 'bot_whitelist_color'}"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
